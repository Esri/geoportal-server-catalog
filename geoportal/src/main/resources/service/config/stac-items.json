{
  "response": {
    "type": "FeatureCollection",
    "timestamp": "{currenttime}",
    "numberMatched": "{numberMatched}",
    "numberReturned": "{numberReturned}",	      
    "features": "{features}",	   
    "links": "service/config/stac-itemLinks.json"
  },
  "featurePropPath": {
    "type": "Feature",	
    "id": "$._source.id",
    "collection": "$._source.collection",		
    "stac_version": "1.0.0",
    "stac_extensions": [
      "https://stac-extensions.github.io/eo/v2.0.0/schema.json",
      "https://stac-extensions.github.io/pointcloud/v2.0.0/schema.json",
      "https://stac-extensions.github.io/video/v1.0.0/schema.json",
      "https://stac-extensions.github.io/processing/v1.2.0/schema.json",
      "https://stac-extensions.github.io/sar/v1.3.0/schema.json",
      "https://stac-extensions.github.io/view/v1.1.0/schema.json"
    ],
    "bbox": ["$._source.envelope_geo", "$._source.bbox"],	
    "geometry": ["$._source.shape_geo", "$._source.geometry"],				
    "properties": {
      "updated": "$._source.sys_modified_dt",
      "datetime": "$._source.sys_modified_dt",
      "eo:platform": "$._source.properties.src_harvested_dataset_s",
      "eo:epsg": 4326,
	  "AcquisitionDate": "$._source.properties.AcquisitionDate_dt"
    },
    "assets": {},
    "links": [
      {
        "rel": "self",
        "href": "{url}/collections/{itemCollectionId}/items/{itemId}",
        "type": "application/geo+json"
      },
      {
        "rel": "root",
        "href": "{url}",
        "type": "application/json"
      },
      {
        "rel": "parent",
        "href": "{url}/collections/{itemCollectionId}",
        "type": "application/json"
      },
      {
        "rel": "collection",
        "href": "{url}/collections/{itemCollectionId}",
        "type": "application/json"
      }
    ]
  }
}