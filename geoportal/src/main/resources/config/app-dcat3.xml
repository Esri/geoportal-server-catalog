<?xml version="1.0" encoding="UTF-8"?>
<beans:beans
	xmlns:beans="http://www.springframework.org/schema/beans"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

  <!--
    DCAT-US 3.0 (https://resources.data.gov/resources/dcat-us3/)

    Produces dcat:Catalog / dcat:Dataset / dcat:DatasetSeries / dcat:DataService.
    Unlike the DCAT-US 1.1 implementation (app-dcat.xml) no Nashorn script is used:
    com.esri.geoportal.dcat3.Dcat3Helper talks to OpenSearch/Elasticsearch directly.
  -->

  
  <beans:bean id="dcat3Config" class="com.esri.geoportal.dcat3.Dcat3Config">
    <!-- Profile declaration -->
    <beans:property name="context" value="${gpt_dcat3Context:https://www.w3.org/ns/dcat.jsonld}"/>
    <beans:property name="conformsTo" value="${gpt_dcat3ConformsTo:https://resources.data.gov/resources/dcat-us3}"/>
    <beans:property name="describedBy" value="${gpt_dcat3DescribedBy:https://resources.data.gov/standards/catalog/dcat-us-3/catalog}"/>

    <!-- Catalog -->
    <beans:property name="baseUrl" value="${gpt_dcat3BaseUrl:http://localhost:8080/geoportal}"/>
    <beans:property name="catalogTitle" value="${gpt_dcat3CatalogTitle:Geoportal Catalog}"/>
    <beans:property name="catalogDescription" value="${gpt_dcat3CatalogDescription:DCAT-US 3.0 catalog generated by Esri Geoportal Server.}"/>
    <beans:property name="catalogIdentifier" value="${gpt_dcat3CatalogIdentifier:}"/>
    <beans:property name="homepage" value="${gpt_dcat3Homepage:}"/>
    <beans:property name="language" value="${gpt_dcat3Language:en}"/>

    <!-- Resource defaults required by the DCAT-US profile -->
    <beans:property name="publisherName" value="${gpt_dcat3PublisherName:Esri}"/>
    <beans:property name="publisherId" value="${gpt_dcat3PublisherId:}"/>
    <beans:property name="contactName" value="${gpt_dcat3ContactName:Your contact point}"/>
    <beans:property name="contactEmail" value="${gpt_dcat3ContactEmail:ankita_srivastava@esri.com}"/>
    <beans:property name="license" value="${gpt_dcat3License:http://www.usa.gov/publicdomain/label/1.0/}"/>
    <beans:property name="rights" value="${gpt_dcat3Rights:}"/>
    <beans:property name="accessLevel" value="${gpt_dcat3AccessLevel:public}"/>
    <beans:property name="accrualPeriodicity" value="${gpt_dcat3AccrualPeriodicity:}"/>
    <beans:property name="bureauCode">
      <beans:list>
        <beans:value>${gpt_dcat3BureauCode:010:04}</beans:value>
      </beans:list>
    </beans:property>
    <beans:property name="programCode">
      <beans:list>
        <beans:value>${gpt_dcat3ProgramCode:010:000}</beans:value>
      </beans:list>
    </beans:property>

    <!-- Behavior -->
    <beans:property name="pageSize" value="${gpt_dcat3PageSize:100}"/>
    <!-- Below prop allows dataSeries to be included in dcat3.json -->
    <beans:property name="includeDatasetSeries" value="${gpt_dcat3IncludeDatasetSeries:true}"/>
    <!-- Below prop allows dataServices ref to be included in dcat3.json or in any distribution-->
    <beans:property name="includeDataServices" value="${gpt_dcat3IncludeDataServices:true}"/>
    <!-- Below prop controls the maximum number of dataset members resolved/emitted for a
         dcat:DatasetSeries (dcat:first/dcat:last sample size and dcat:seriesMember completeness
         threshold), used consistently by both the cached dcat3.json builder and the live
         /dcat3/datasetSeries and /dcat3/datasetSeries/{id} endpoints when includeSeriesMember=true.
         Be careful raising this value if collections may contain a very large number of records. -->
    <beans:property name="maxSeriesMemberCnt" value="${gpt_dcat3MaxSeriesMemberCnt:1000}"/>
    <beans:property name="publicRecordsOnly" value="${gpt_dcat3PublicRecordsOnly:true}"/>
    <beans:property name="prettyPrint" value="${gpt_dcat3PrettyPrint:true}"/>
    <beans:property name="mappingConfigPath" value="${gpt_dcat3MappingConfigPath:service/config/dcat3.json}"/>
  </beans:bean>

  <beans:bean id="dcat3Builder" class="com.esri.geoportal.dcat3.Dcat3Builder">
    <beans:constructor-arg ref="dcat3Cache"/>
    <beans:constructor-arg ref="dcat3Config"/>
  </beans:bean>
  
<beans:bean id="dcat3Cache" class="com.esri.geoportal.dcat3.Dcat3Cache" init-method="init">
    <!-- DCAT-US 3.0 cache folder, or empty for default: <USER_HOME>/dcat3/cache -->
    <beans:constructor-arg value="${gpt_dcat3CacheFolder:}"/>
  </beans:bean>

  <beans:bean id="dcat3Controller" class="com.esri.geoportal.dcat3.Dcat3Controller"
              init-method="init" destroy-method="destroy">
    <!-- Build start time (24 hour clock, HH:mm) or empty to disable auto-generation -->
    <beans:constructor-arg value="${gpt_dcat3RunAt:}"/>
    <beans:constructor-arg ref="dcat3Cache"/>
    <beans:constructor-arg ref="dcat3Builder"/>
  </beans:bean>

</beans:beans>
